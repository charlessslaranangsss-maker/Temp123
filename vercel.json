{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://firebaseappcheck.googleapis.com https://content-firebaseappcheck.googleapis.com https://www.google.com/recaptcha/; frame-src https://www.google.com/recaptcha/; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/inventory/laundry-trailers/",
      "destination": "/equipment-rental/laundry-trailers/",
      "permanent": true
    },
    {
      "source": "/handwashing-stations/",
      "destination": "/equipment-rental/handwashing-stations/",
      "permanent": true
    },
    {
      "source": "/classroom-trailers/",
      "destination": "/equipment-rental/classroom-trailers/",
      "permanent": true
    },
    {
      "source": "/restroom-trailers/",
      "destination": "/equipment-rental/restroom-trailers/",
      "permanent": true
    },
    {
      "source": "/temporary-shower-trailers/",
      "destination": "/equipment-rental/shower-trailer/",
      "permanent": true
    },
    {
      "source": "/mobile-sleep-trailers/",
      "destination": "/equipment-rental/mobile-sleep-trailers/",
      "permanent": true
    },
    {
      "source": "/mobile-office-trailers/",
      "destination": "/equipment-rental/mobile-office-trailers/",
      "permanent": true
    },
    {
      "source": "/shower-trailer/",
      "destination": "/equipment-rental/shower-trailer/",
      "permanent": true
    },
    {
      "source": "/military-command-center-trailers/",
      "destination": "/equipment-rental/modular-command-center-trailers/",
      "permanent": true
    },
    {
      "source": "/mobile-command-trailers/",
      "destination": "/equipment-rental/modular-command-center-trailers/",
      "permanent": true
    },
    {
