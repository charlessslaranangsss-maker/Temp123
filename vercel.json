      "destination": "/equipment-rental/stair-rentals/",
      "permanent": true
    },
    {
      "source": "/refrigeration-trailers/",
      "destination": "/equipment-rental/refrigeration/",
      "permanent": true
    },
    {
      "source": "/mobile-kitchen-trailers/",
      "destination": "/equipment-rental/mobile-kitchen-trailers/",
