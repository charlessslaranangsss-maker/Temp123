# Runtime settings remain on the server. /api/public-config returns only the
# Firebase Web identifiers and reCAPTCHA site key that browsers must receive.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
RECAPTCHA_ENTERPRISE_SITE_KEY=
# Server-only credentials. Use separate preview and production projects.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=https://temporary-123-87345-default-rtdb.firebaseio.com
FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional one-line alternative for deployment tools that cannot preserve PEM newlines.
FIREBASE_PRIVATE_KEY_BASE64=
RESEND_API_KEY=
RESEND_FROM=
LEADS_TO_EMAIL=
ALLOWED_ORIGINS=
RATE_LIMIT_SECRET=
CRON_SECRET=
# Explicit enabling after staging validation. Defaults disabled.
CONTACT_ENABLED=false

# Server-only SEO provider credentials. Never use VITE_ prefixes.
# Ahrefs free Domain Rating endpoint token.
AHREFS_API_TOKEN=
# Moz URL Metrics API credentials.
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=
# Google Search Console property, for example sc-domain:temporary123.com.
GOOGLE_SEARCH_CONSOLE_SITE_URL=
# Use either a short-lived access token OR a service account granted access to the property.
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
# Firebase RTDB collection containing programmatic SEO rows.
SEO_CONTENT_DATABASE_PATH=
# Comma-separated fields that must be populated on every content row.
SEO_CONTENT_REQUIRED_FIELDS=title,h1,content
FIRESTORE_CITIES_COLLECTION=cities
# Enable only when this domain is served by Firebase Hosting and Cloud Logging is configured.
FIREBASE_HOSTING_LOGS_ENABLED=false
GOOGLE_CLOUD_LOG_LOOKBACK_HOURS=168
# Optional project-specific Logging filter; requires logging.viewer access for the service account.
GOOGLE_CLOUD_LOG_FILTER=
# Optional override for the origin whose location sitemap URLs are checked.
SEO_DIAGNOSTICS_ORIGIN=
